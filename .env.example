# FinNavigator environment template — copy to .env and fill in.
# .env is gitignored. NEVER commit real secrets.

# ---- LLM backend selection ----
# One of: ollama | openai | anthropic | nvidia | webgpu
LLM_BACKEND=ollama
LLM_TEMPERATURE=0.3

# ---- Ollama (default for desktop, has issues with Qwen3-VL on 0.23.x) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=finnav-qwen3-vl:Q4_K_M

# ---- llama-cpp-python (local Qwen3-VL fine-tune via llama.cpp; works around Ollama Conv3D bug) ----
# Default GGUF lives at models/finnav-gguf/ — pull from HF on first run if missing
LLAMA_GGUF_PATH=models/finnav-gguf/Qwen3-VL-4B-Instruct.Q4_K_M.gguf
LLAMA_N_CTX=4096
LLAMA_N_GPU_LAYERS=0
LLAMA_MAX_TOKENS=1024

# ---- NVIDIA NIM (default for cloud / web) ----
# Get key at https://build.nvidia.com
NVIDIA_API_KEY=
# Override if pointing at a custom-deployed fine-tuned NIM endpoint
MODEL_NAME=meta/llama-3.1-70b-instruct

# ---- OpenAI (optional fallback) ----
OPENAI_API_KEY=

# ---- Anthropic (optional fallback) ----
ANTHROPIC_API_KEY=

# ---- Financial data APIs ----
SEC_API_KEY=
ALPHA_VANTAGE_KEY=
STOCKFIT_API_KEY=

# ---- Messaging / alerts ----
VOICEFLOW_API_KEY=

# ---- RAG store ----
PERSIST_DIRECTORY=./data/chroma_db

# ---- Frontend → backend (web/PWA) ----
# Used by Flet web build to find the Fly-hosted FastAPI.
# Leave empty for desktop builds (in-process Python calls).
FINNAV_API_URL=
